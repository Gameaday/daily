# Nothing is required: with no .env the stack pulls the newest release
# from GHCR, serves plain HTTP on port 8081, and keeps the end-of-day
# score archive under /opt/data/daily. Copy to .env only to override:
# TAG=v1.0.0          # pin one release instead of latest (rollback: set the previous tag)
# WEB_PORT=8081
# DATA_DIR=/opt/data/daily
# SCORES_UPSTREAM=scores:8787
