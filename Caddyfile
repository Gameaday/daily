# Caddy config for the Docker deploy.
# Plain HTTP only: this container is meant to sit behind an edge proxy
# (Traefik, nginx, ...) that terminates TLS. The site it serves contains
# no puzzle banks - puzzles come from the scores container over the
# compose network.
{
    auto_https off
}
:80 {
    # global-curve + puzzle API -> the scores container (never exposed to the host)
    handle_path /api/* {
        reverse_proxy {$SCORES_UPSTREAM}
    }

    # cache policy: game HTML always revalidates (a new image is what ships
    # new content, and the URLs are unversioned), shared assets get a
    # modest public cache. The API sets its own Cache-Control per route.
    @assets path *.css *.js *.svg *.png *.ico *.woff2
    handle @assets {
        header Cache-Control "public, max-age=3600"
        header X-Content-Type-Options nosniff
        header Referrer-Policy no-referrer
        header X-Frame-Options SAMEORIGIN
        root * /srv/daily
        file_server
    }

    handle {
        header Cache-Control "no-cache"
        header X-Content-Type-Options nosniff
        header Referrer-Policy no-referrer
        header X-Frame-Options SAMEORIGIN
        root * /srv/daily
        file_server
    }
}
