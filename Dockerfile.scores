# Global-curve + puzzle-delivery container: the stdlib-only Python service.
# The puzzle store is generated by a throwaway node stage and copied in
# next to server.py - the gitignored scores/puzzles.json never ships in
# git, and the container stays self-contained.
# In-memory by design - NO volumes, nothing is ever written to disk.
# Binds 0.0.0.0 *inside* the container so Caddy can reach it over the
# compose network; the port is never published to the host (see compose).
FROM node:20-alpine AS puzzles
WORKDIR /repo
COPY . .
RUN node tools/export-puzzles.mjs

FROM python:3.12-slim
WORKDIR /app
COPY scores/server.py server.py
COPY --from=puzzles /repo/scores/puzzles.json puzzles.json
EXPOSE 8787
CMD ["python3", "-u", "server.py", "--host", "0.0.0.0", "--port", "8787"]
