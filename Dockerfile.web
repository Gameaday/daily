# Static site container: the ONLINE bundle is baked in at build time.
# The bundle ships with every puzzle bank stripped - puzzles arrive at
# runtime from the scores service - so a new image is what ships new
# site content (the release workflow builds and pushes it on every green
# tag).
FROM node:20-alpine AS build
WORKDIR /repo
COPY . .
RUN node tools/export-puzzles.mjs && node tools/build-bundles.mjs

FROM caddy:2.8-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/dist/online /srv/daily
EXPOSE 80
