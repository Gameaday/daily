# One-shot updater, fired by daily-update.timer every few minutes.
# Install:
#   sudo cp deploy/daily-update.service deploy/daily-update.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now daily-update.timer
# Edit the two paths below if your clone lives somewhere else.

[Unit]
Description=Pull green main and rebuild the daily warmup containers

[Service]
Type=oneshot
WorkingDirectory=/home/pi/daily
ExecStart=/usr/bin/python3 /home/pi/daily/deploy/pull.py
# Environment=GITHUB_TOKEN=gh_xxx   # only needed if the repo is private
