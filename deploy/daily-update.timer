# Checks GitHub for a green main every 5 minutes and updates when there is one.
# The Pi only ever makes OUTBOUND connections - nothing can reach in.

[Unit]
Description=Check for a green main on GitHub every 5 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
