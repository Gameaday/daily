# Checks GitHub for a new green-tagged release every 5 minutes and deploys
# when there is one. The Pi only ever makes OUTBOUND connections - nothing can
# reach in.

[Unit]
Description=Check GitHub for a new green-tagged release every 5 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
