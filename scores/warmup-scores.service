[Unit]
Description=Warmup global curve (fresh-day stats + read-only day archive)
After=network.target

[Service]
DynamicUser=yes
StateDirectory=warmup-scores
ExecStart=/usr/bin/python3 /srv/daily/scores/server.py --port 8787 --host 127.0.0.1 --archive-dir /var/lib/warmup-scores
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
